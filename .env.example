# Sao chép thành file .env — không commit .env lên git.
#
# Cách 1 — SMTP (luôn hoạt động nếu chưa cài django-anymail):
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WebGIS Cửa Hàng <no-reply@example.com>
#
# Cách 2 — Mailtrap API (sau khi: pip install "django-anymail[mailtrap]")
# Nếu MAILTRAP_API_TOKEN có giá trị và đã cài anymail, Django sẽ ưu tiên API.
MAILTRAP_API_TOKEN=
MAILTRAP_SANDBOX_ID=4464527
